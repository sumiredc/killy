    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "./jest.setup-after-env.js"
    ],
    "testTimeout": 30000
  }
