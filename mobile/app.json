{
  "expo": {
    "name": "Killy",
    "slug": "killy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "killy",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sumiredc.killy",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sumiredc.killy",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "googleServicesFile": "./firebase/google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-no-such-plugin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Killy uses the camera to read the QR code shown by killy agent pair.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "icon": "./assets/images/notification-icon.png",
          "color": "#9046FF"
        }
      ]
    ],
    "locales": {
      "ja": "./locales/ja.json"
    },
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fd79de26-81ac-4ab1-8152-c6081d1b0730"
      }
    },
    "owner": "sumire-sakamoto",
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    }
  }
}
